{
  "name": "codex-imps",
  "version": "0.3.0",
  "description": "Imps: single-purpose, isolated Codex SDK agents for common CLI tools",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnlindquist/codex-imps.git"
  },
  "keywords": [
    "codex",
    "agents",
    "cli",
    "ai",
    "openai"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "files": [
    "imps",
    "lib",
    "docs",
    "evals",
    "imp.ts",
    "imps.ts",
    "create.ts",
    "evals.ts",
    "README.md",
    "VISION.md"
  ],
  "exports": {
    ".": "./lib/isolated.ts",
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "imp-": "./imps/imp-",
    "imps-": "./imps/imp-",
    "imp-cmux": "./imps/imp-cmux",
    "imp-cmux-extensions": "./imps/imp-cmux-extensions",
    "imp-git": "./imps/imp-git",
    "imp-docker": "./imps/imp-docker",
    "imp-npm": "./imps/imp-npm",
    "imp-kubectl": "./imps/imp-kubectl",
    "imp-terraform": "./imps/imp-terraform",
    "imp-aws": "./imps/imp-aws",
    "imp-jq": "./imps/imp-jq",
    "imp-rg": "./imps/imp-rg",
    "imp-psql": "./imps/imp-psql",
    "imp-gcloud": "./imps/imp-gcloud",
    "imp-gh": "./imps/imp-gh",
    "imp-github-examples": "./imps/imp-github-examples",
    "imp-gmail": "./imps/imp-gmail",
    "imp-karabiner": "./imps/imp-karabiner",
    "imp-packx": "./imps/imp-packx",
    "imp-faq": "./imps/imp-faq",
    "imp-memory": "./imps/imp-memory",
    "imp-bird": "./imps/imp-bird",
    "imp-browser": "./imps/imp-browser",
    "imp-browser-automate": "./imps/imp-browser-automate",
    "imp-codex": "./imps/imp-codex",
    "imp-demo": "./imps/imp-demo",
    "imp-hooks": "./imps/imp-hooks",
    "imp-minimal": "./imps/imp-minimal",
    "imp-prompt-standard": "./imps/imp-prompt-standard",
    "imp-monkeys": "./imps/imp-monkeys",
    "imp-ffmpeg": "./imps/imp-ffmpeg",
    "imp-imagemagick": "./imps/imp-imagemagick",
    "imp-yt-dlp": "./imps/imp-yt-dlp",
    "imp-osascript": "./imps/imp-osascript",
    "imp-brew": "./imps/imp-brew",
    "imp-create": "./create.ts",
    "imp": "./imp.ts",
    "imps": "./imps.ts"
  },
  "scripts": {
    "create": "bun create.ts",
    "test": "bun test",
    "evals": "bun evals.ts"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@openai/codex-sdk": "^0.134.0"
  }
}
